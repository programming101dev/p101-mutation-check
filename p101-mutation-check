#!/usr/bin/env python3
"""Run focused Clang-located C mutants in disposable project copies."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import shlex
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Any


DEFAULT_TIMEOUT_SECONDS = 120.0
DEFAULT_MAX_MUTANTS = 100
IGNORED_NAMES = {".git", ".pytest_cache", "__pycache__", "build", "compile_commands.json", "coverage", "debug", "profile"}


@dataclass(frozen=True)
class Result:
    candidate: dict[str, Any]
    outcome: str
    returncode: int | None
    detail: str


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Measure whether tests kill focused C mutants.")
    parser.add_argument("project", type=Path, help="project root")
    parser.add_argument("--compile-db", required=True, type=Path, help="compile_commands.json used to locate active C translation units")
    parser.add_argument("--audit", type=Path, default=Path(__file__).resolve().parents[1] / "p101-wrapper-audit" / "p101-wrapper-audit")
    parser.add_argument("--clang", default=os.environ.get("P101_WRAPPER_AUDIT_CLANG", "clang"))
    parser.add_argument("--max-mutants", type=int, default=DEFAULT_MAX_MUTANTS)
    parser.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT_SECONDS)
    parser.add_argument("--operator", action="append", default=[], help="limit to a mutation operator; may be repeated")
    parser.add_argument("--list", action="store_true", help="list candidates without running tests")
    parser.add_argument("--json", action="store_true", help="emit JSON")
    parser.add_argument("test_command", nargs=argparse.REMAINDER, help="test command after --")
    args = parser.parse_args(argv)
    if args.test_command and args.test_command[0] == "--":
        args.test_command = args.test_command[1:]
    return args


def ignored(directory: str, names: list[str]) -> set[str]:
    del directory
    return {name for name in names if name in IGNORED_NAMES or name.startswith(("build-", "coverage-", "debug-", "profile-"))}


def discover(args: argparse.Namespace, output: Path) -> list[dict[str, Any]]:
    command = [
        str(args.audit),
        "--clang",
        args.clang,
        "--compile-db",
        str(args.compile_db),
        "--compile-db-only",
        "--mutation-candidates-output",
        str(output),
        str(args.project),
    ]
    result = subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, check=False)
    if result.returncode > 1 or not output.is_file():
        raise RuntimeError(result.stderr.strip() or "candidate discovery failed")
    data = json.loads(output.read_text(encoding="utf-8"))
    if data.get("schema") != "p101-mutation-candidates-v1" or not isinstance(data.get("candidates"), list):
        raise RuntimeError("candidate discovery returned an unsupported schema")
    candidates = data["candidates"]
    if args.operator:
        allowed = set(args.operator)
        candidates = [item for item in candidates if item.get("operator") in allowed]
    return candidates[: args.max_mutants]


def run_command(command: list[str], cwd: Path, timeout: float) -> tuple[int | None, str]:
    try:
        result = subprocess.run(command, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=timeout, check=False)
    except subprocess.TimeoutExpired as exc:
        output = exc.stdout if isinstance(exc.stdout, str) else ""
        return None, output[-2000:]
    return result.returncode, result.stdout[-2000:]


def rewrite_project_path(args: argparse.Namespace, copied: Path, value: str) -> str:
    rewritten = value
    for spelling in sorted(args.project_spellings, key=len, reverse=True):
        rewritten = rewritten.replace(spelling, str(copied))
    return rewritten


def compile_mutant(args: argparse.Namespace, copied: Path, candidate: dict[str, Any]) -> tuple[int | None, str]:
    data = json.loads(args.compile_db.read_text(encoding="utf-8"))
    original = Path(str(candidate["path"])).resolve()

    def entry_path(item: dict[str, Any]) -> Path:
        file_path = Path(str(item.get("file", "")))
        if not file_path.is_absolute():
            file_path = Path(str(item.get("directory", "."))) / file_path
        return file_path.resolve()

    entry = next(
        (
            item
            for item in data
            if isinstance(item, dict) and entry_path(item) == original
        ),
        None,
    )
    if entry is None:
        raise RuntimeError(f"compile database has no command for mutation candidate: {original}")
    command = [str(value) for value in entry["arguments"]] if isinstance(entry.get("arguments"), list) else shlex.split(str(entry.get("command", "")))
    if not command:
        raise RuntimeError(f"compile database command is empty for mutation candidate: {original}")

    rewritten: list[str] = []
    skip_next = False
    for value in command:
        if skip_next:
            skip_next = False
            continue
        if value in {"-c", "-o", "-MF", "-MT", "-MQ"}:
            skip_next = value != "-c"
            continue
        if value.startswith("-o") and value != "-ObjC":
            continue
        rewritten_value = rewrite_project_path(args, copied, value)
        rewritten.append(rewritten_value)
    rewritten.extend(["-fsyntax-only"])
    directory = Path(entry.get("directory", args.project)).resolve()
    try:
        relative_directory = directory.relative_to(args.project)
    except ValueError as exc:
        raise RuntimeError(f"compile database directory is outside project: {directory}") from exc
    return run_command(rewritten, copied / relative_directory, args.timeout)


def apply_candidate(project: Path, copied: Path, candidate: dict[str, Any]) -> None:
    original_path = Path(str(candidate["path"])).resolve()
    try:
        relative = original_path.relative_to(project)
    except ValueError as exc:
        raise RuntimeError(f"candidate is outside project: {original_path}") from exc
    target = copied / relative
    contents = target.read_bytes()
    start = int(candidate["start"])
    end = int(candidate["end"])
    original = str(candidate["original"]).encode()
    replacement = str(candidate["replacement"]).encode()
    if start < 0 or end > len(contents) or contents[start:end] != original:
        raise RuntimeError(f"candidate source changed: {relative}:{candidate['line']}")
    target.write_bytes(contents[:start] + replacement + contents[end:])


def execute_mutant(args: argparse.Namespace, candidate: dict[str, Any]) -> Result:
    with tempfile.TemporaryDirectory(prefix="p101-mutation-check-mutant-") as temp:
        copied = Path(temp) / "project"
        shutil.copytree(args.project, copied, symlinks=True, ignore=ignored)
        apply_candidate(args.project, copied, candidate)
        compile_returncode, compile_detail = compile_mutant(args, copied, candidate)
        if compile_returncode is None:
            return Result(candidate, "inconclusive", None, compile_detail)
        if compile_returncode != 0:
            return Result(candidate, "inconclusive", compile_returncode, f"mutant did not compile\n{compile_detail}")
        test_command = [rewrite_project_path(args, copied, value) for value in args.test_command]
        returncode, detail = run_command(test_command, copied, args.timeout)
        if returncode is None:
            return Result(candidate, "inconclusive", None, detail)
        if returncode == 0:
            return Result(candidate, "survived", returncode, detail)
        return Result(candidate, "killed", returncode, detail)


def output_results(args: argparse.Namespace, results: list[Result], candidate_count: int) -> None:
    survived = [result for result in results if result.outcome == "survived"]
    killed = sum(result.outcome == "killed" for result in results)
    inconclusive = sum(result.outcome == "inconclusive" for result in results)
    if args.json:
        findings = [
            {
                "id": "P101-MUTATION-001",
                "severity": "warning",
                "location": {"path": result.candidate["path"], "line": result.candidate["line"]},
                "message": "the test command passed after a focused source mutation",
                "evidence": {
                    "operator": result.candidate["operator"],
                    "original": result.candidate["original"],
                    "replacement": result.candidate["replacement"],
                },
            }
            for result in survived
        ]
        print(json.dumps({"schema": "p101-mutation-check-findings-v1", "findings": findings, "summary": {"selected": candidate_count, "killed": killed, "survived": len(survived), "inconclusive": inconclusive}}, indent=2, sort_keys=True))
        return
    for result in survived:
        item = result.candidate
        print(f"P101-MUTATION-001: {item['path']}:{item['line']}: survived {item['operator']}: {item['original']} -> {item['replacement']}")
    print(f"p101-mutation-check: selected={candidate_count} killed={killed} survived={len(survived)} inconclusive={inconclusive}")


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    supplied_project = str(args.project)
    args.project = args.project.resolve()
    args.project_spellings = {supplied_project, str(args.project)}
    args.compile_db = args.compile_db.resolve()
    if not args.project.is_dir() or not args.compile_db.is_file() or not args.audit.is_file():
        print("p101-mutation-check: project, compile database, or wrapper audit is missing", file=sys.stderr)
        return 2
    if args.max_mutants <= 0 or args.timeout <= 0:
        print("p101-mutation-check: --max-mutants and --timeout must be positive", file=sys.stderr)
        return 2
    if not args.list and not args.test_command:
        print("p101-mutation-check: supply a test command after --, or use --list", file=sys.stderr)
        return 2

    try:
        with tempfile.TemporaryDirectory(prefix="p101-mutation-check-discovery-") as temp:
            candidates = discover(args, Path(temp) / "candidates.json")
        if args.list:
            for item in candidates:
                print(f"{item['path']}:{item['line']}: {item['operator']}: {item['original']} -> {item['replacement']}")
            print(f"p101-mutation-check: {len(candidates)} candidate(s)")
            return 0
        if not candidates:
            raise RuntimeError("candidate discovery produced no mutants; refusing a vacuous mutation-check pass")
        baseline, detail = run_command(args.test_command, args.project, args.timeout)
        if baseline is None:
            raise RuntimeError("baseline test command timed out")
        if baseline != 0:
            raise RuntimeError(f"baseline test command failed with exit {baseline}\n{detail}")
        results = [execute_mutant(args, candidate) for candidate in candidates]
    except (OSError, ValueError, KeyError, json.JSONDecodeError, RuntimeError) as exc:
        print(f"p101-mutation-check: {exc}", file=sys.stderr)
        return 2

    output_results(args, results, len(candidates))
    if any(result.outcome == "inconclusive" for result in results):
        return 2
    return 1 if any(result.outcome == "survived" for result in results) else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
